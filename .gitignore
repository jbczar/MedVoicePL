# ============================================================================
# MedVoicePL — Monorepo .gitignore
# ============================================================================

# ------------------------------------------
# Python
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl

# ------------------------------------------
# Virtual environments
# ------------------------------------------
.venv/
venv/
env/
.python-version

# ------------------------------------------
# uv
# ------------------------------------------
uv.lock

# ------------------------------------------
# IDE / Editor
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ------------------------------------------
# Environment variables (NEVER commit secrets)
# ------------------------------------------
.env
.env.local
.env.*.local

# ------------------------------------------
# Docker
# ------------------------------------------
docker-compose.override.yml

# ------------------------------------------
# ML Models (too large for git)
# ------------------------------------------
application/on_premise/models/*.bin
application/on_premise/models/*.pt
application/on_premise/models/*.onnx
application/on_premise/models/*.safetensors
application/on_premise/models/*.gguf

# ------------------------------------------
# Dataset Pipeline — Generated Output
# ------------------------------------------
dataset_pipeline/output/scenarios/
dataset_pipeline/output/raw_audio/
dataset_pipeline/output/mixed_audio/
dataset_pipeline/output/audio/
dataset_pipeline/output/manifest.json

# Audio binaries — reference voices (from Common Voice), noise library
# (from Freesound), and any stray WAV/MP3/OGG. README.md in those dirs is
# whitelisted below so provenance metadata still ships.
dataset_pipeline/reference_voices/*.wav
dataset_pipeline/noise_library/*.wav
!dataset_pipeline/reference_voices/README.md
!dataset_pipeline/noise_library/README.md
*.wav
*.mp3
*.ogg
*.flac

# ------------------------------------------
# On-Premise — Transcripts (Phase 2a)
# ------------------------------------------
# Un-anonymized transcripts never leave the local dev box.
application/on_premise/output/

# ------------------------------------------
# Research — Experiment Results
# ------------------------------------------
research_and_testing/results/benchmarks/
research_and_testing/results/reports/
research_and_testing/results/figures/

# ------------------------------------------
# Vector Store (rebuilt from source data)
# ------------------------------------------
application/cloud/data/vectorstore/*
!application/cloud/data/vectorstore/.gitkeep

# ------------------------------------------
# Jupyter Notebooks — outputs
# ------------------------------------------
.ipynb_checkpoints/

# ------------------------------------------
# Node.js / Next.js (frontend)
# ------------------------------------------
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# Testing / Coverage
# ------------------------------------------
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------
# Logs
# ------------------------------------------
*.log
logs/
