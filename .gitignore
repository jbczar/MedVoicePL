# ============================================================================
# MedVoicePL — Monorepo .gitignore
# ============================================================================

# ------------------------------------------
# Python
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl

# ------------------------------------------
# Virtual environments
# ------------------------------------------
.venv/
venv/
env/
.python-version

# ------------------------------------------
# IDE / Editor
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ------------------------------------------
# Environment variables and secrets 
# ------------------------------------------
.env
.env.local
.env.*.local
.env.bak
.env.bak*

# ------------------------------------------
# Docker
# ------------------------------------------
docker-compose.override.yml

# ------------------------------------------
# ML Models 
# ------------------------------------------
application/on_premise/models/*.bin
application/on_premise/models/*.pt
application/on_premise/models/*.onnx
application/on_premise/models/*.safetensors
application/on_premise/models/*.gguf

# ------------------------------------------
# Dataset Pipeline — Generated Output (entire output/ tree is regen-able)
# ------------------------------------------
dataset_pipeline/output/

# Audio binaries — reference voices (from Common Voice), noise library
# (from Freesound), and any stray WAV/MP3/OGG. README.md in those dirs is
# whitelisted below so provenance metadata still ships.
dataset_pipeline/reference_voices/*.wav
dataset_pipeline/noise_library/*.wav
!dataset_pipeline/reference_voices/README.md
!dataset_pipeline/noise_library/README.md
*.wav
*.mp3
*.ogg
*.flac

# ------------------------------------------
# On-Premise — Transcripts (Phase 2a)
# ------------------------------------------
# Un-anonymized transcripts never leave the local dev box.
application/on_premise/output/

# ------------------------------------------
# Research — Experiment Results (raw eval JSONs; reports live in docs/)
# ------------------------------------------
research_and_testing/results/

# ------------------------------------------
# Vector Store (rebuilt from source data)
# ------------------------------------------
application/cloud/data/vectorstore/*
!application/cloud/data/vectorstore/.gitkeep

# Phase 3a — cloud agent outputs + NFZ index + Qdrant DB (regen-able)
application/cloud/output/
application/cloud/data/nfz_formulary/raw/
application/cloud/data/nfz_formulary/index_*.json
application/cloud/data/nfz_formulary/atc_cache.json
application/cloud/data/qdrant/

application/on_premise/audit/
application/gateway/output/
application/gateway/audit/

# Hidden drug_references (rare LLM artifacts; non-hidden are tracked fixtures)
research_and_testing/test_cases/expected_outputs/drug_references/.*.json

# ------------------------------------------
# Jupyter Notebooks — outputs
# ------------------------------------------
.ipynb_checkpoints/

# ------------------------------------------
# Node.js / Next.js (frontend)
# ------------------------------------------
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

application/frontend/node_modules
application/frontend/.next
application/frontend/out
application/frontend/coverage
application/frontend/tsconfig.tsbuildinfo

# ------------------------------------------
# Testing / Coverage / Benchmarks
# ------------------------------------------
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.benchmarks/

# ------------------------------------------
# Logs
# ------------------------------------------
*.log
logs/

# ------------------------------------------
# Claude Code workspace (worktrees + per-project context)
# ------------------------------------------
.claude/
CLAUDE.md

# ------------------------------------------
# Master's thesis — kept local, NOT a part of the open-source repo.
# ------------------------------------------
Praca_magisterska/

