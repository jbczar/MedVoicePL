# ============================================================================
# MedVoicePL — Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ============================================================================

# ------------------------------------------
# Cloud LLM Providers (used by cloud/ module)
# ------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AI...                   # AI Studio key (unused in Phase 1a — dataset uses Vertex AI)

# ------------------------------------------
# Google Cloud / Vertex AI
# ------------------------------------------
# Auth: run `gcloud auth application-default login` OR set
# GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON key.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1      # e.g. us-central1, europe-west4
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ------------------------------------------
# Dataset Pipeline — Scenario Generation LLM (via Vertex AI)
# ------------------------------------------
DATASET_LLM_PROVIDER=google            # openai | anthropic | google (vertex)
DATASET_LLM_MODEL=gemini-2.5-pro       # Model used for scenario generation
DATASET_LLM_MAX_CONCURRENCY=4          # Parallel scenario requests

# ------------------------------------------
# Dataset Pipeline — TTS (Phase 1b)
# ------------------------------------------
TTS_DEVICE=auto                        # auto | mps | cuda | cpu
TTS_MODEL_CACHE=~/.cache/medvoicepl/xtts   # ~2 GB model weights, outside the repo
TTS_ACCEPT_COQUI_LICENSE=1             # coqui-tts requires explicit MPL-2.0 ack

# ------------------------------------------
# On-Premise — STT (Phase 2a: application/on_premise/stt)
# ------------------------------------------
WHISPER_BACKEND=mlx                   # mlx | faster-whisper
WHISPER_MODEL_SIZE=large-v3           # faster-whisper: tiny | base | small | medium | large-v3
WHISPER_MLX_REPO=mlx-community/whisper-large-v3-mlx
WHISPER_DEVICE=auto                   # auto | cpu | cuda (faster-whisper only; mlx always Metal)
WHISPER_COMPUTE_TYPE=int8             # faster-whisper only: int8 | int8_float32 | float16 (fp16 crashes on CPU)

# ------------------------------------------
# On-Premise — Diarization (pyannote.audio 3.1)
# ------------------------------------------
# pyannote/speaker-diarization-3.1 is a GATED model — you must:
#   1) Accept the license on https://huggingface.co/pyannote/speaker-diarization-3.1
#   2) Create a read token at https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=
PYANNOTE_DEVICE=auto                  # auto | cpu | cuda | mps

# ------------------------------------------
# On-Premise — SLM (Phase 2b: application/on_premise/structuring)
# ------------------------------------------
SLM_BACKEND=mlx-lm                                          # mlx-lm | llama-cpp
SLM_MODEL_ID=speakleash/Bielik-11B-v3.0-Instruct
SLM_MLX_REPO=speakleash/Bielik-11B-v3.0-Instruct-MLX-4bit   # first-party SpeakLeash MLX 4-bit (ungated). v2.3 community repack went 404.
SLM_GGUF_PATH=                                              # absolute path to .gguf for llama-cpp (empty = disabled)
SLM_DEVICE=auto                                             # auto | cpu | cuda (llama-cpp only; mlx-lm always Metal)
SLM_MAX_NEW_TOKENS=2048
SLM_TEMPERATURE=0.1
SLM_STRUCTURED_MODE=grammar                                 # grammar | raw — raw falls back to retry-only

# ------------------------------------------
# On-Premise — Anonymization + API (Phase 2c)
# ------------------------------------------
# Bumped on every breaking change to the anonymizer (operator strategy,
# token grammar, recognizer set). Cached anonymized outputs include this
# version; bumping invalidates the cache without --force.
ANONYMIZER_VERSION=2c.0
# Default Polish medical-record retention floor; refine with legal review
# before production. Audit JSON records carry `expires_at = now + AUDIT_RETENTION_DAYS`.
AUDIT_RETENTION_DAYS=730
# GDPR Article 30 controller name — appears in every audit record.
ANONYMIZER_CONTROLLER=MedVoicePL-Dev
# FastAPI bind. Phase 2c is localhost-only (Phase 3 gateway will mediate
# outside access via auth + rate limit). API logs WARN if HOST != 127.0.0.1.
ON_PREMISE_API_HOST=127.0.0.1
ON_PREMISE_API_PORT=8001

# ------------------------------------------
# Cloud — Agent (Phase 3a: cloud LangGraph agent + RAG + NFZ)
# ------------------------------------------
# Reuses GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION from Phase 1a — same
# Vertex AI auth surface, no separate provider.
VERTEX_AGENT_MODEL=gemini-2.0-pro
AGENT_VERSION=3a.0
CLOUD_API_HOST=127.0.0.1
CLOUD_API_PORT=8002
# Empty-output rule (Phase 3a DD-2.5, hybrid mode since 2026-05-12).
#   `false` (default, demo mode) — Vertex Gemini always called, even on
#       preliminary diagnoses; rationales prefixed with conditional caveat.
#       Maximizes demo value: every visit produces drug + NFZ refund tier.
#   `true` (production-safe) — short-circuits to empty drug list when
#       diagnosis is preliminary AND SOAP plan has no medications.
AGENT_EMPTY_OUTPUT_RULE=false
# NFZ refundacja list — official source (gov.pl). Bumped bimonthly.
# Leave blank to require explicit `--xlsx-path` on ingest_nfz.py.
NFZ_XLSX_URL=
NFZ_INDEX_DIR=application/cloud/data/nfz_formulary
# ChPL excerpts (hand-curated) — see Phase 3a DD-3.
CHPL_CORPUS_DIR=application/cloud/data/chpl_excerpts
# Qdrant — in-process mode. SQLite-style local DB at QDRANT_PATH.
QDRANT_PATH=application/cloud/data/qdrant
QDRANT_COLLECTION=chpl_excerpts

# ------------------------------------------
# Cloud — Vector Database (legacy / 3b+)
# ------------------------------------------
# Phase 3a uses Qdrant in-process (see DD-1 in plan). VECTORDB_PROVIDER kept
# as a future config knob; chroma path is documented as deferred.
VECTORDB_PROVIDER=qdrant              # qdrant | chroma (3a only implements qdrant)
VECTORDB_HOST=localhost
VECTORDB_PORT=8000
EMBEDDING_MODEL=sdadas/mmlw-roberta-large

# ------------------------------------------
# Cloud — RAG Configuration
# ------------------------------------------
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# ------------------------------------------
# Gateway — API Server
# ------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_WORKERS=1
GATEWAY_LOG_LEVEL=info

# ------------------------------------------
# Frontend — Next.js
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080

# ------------------------------------------
# Docker Compose
# ------------------------------------------
COMPOSE_PROJECT_NAME=medvoicepl


# ------------------------------------------
# Dataset Pipeline — Reference Voices (Common Voice download)
# ------------------------------------------
# API key for Mozilla Data Collective (mozilladatacollective.com).
# Used by fetch_reference_voices.py to download Common Voice 25.0 Polish.
# Get your key at: https://mozilladatacollective.com
MEDVOICEPL_VOICES_API_KEY=your-voices-api-key-here

# ------------------------------------------
# Dataset Pipeline — Noise library (Phase 1b.1)
# ------------------------------------------
# API key for Freesound.org, used by fetch_noise_library.py to download
# CC0/CC-BY clinical ambience clips (keyboard, HVAC, chatter, etc.).
# Get a key at: https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=your-freesound-api-key-here

# ------------------------------------------
# Phase 3b — Gateway (orchestrator + auth)
# ------------------------------------------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_DOCTOR_USERNAME=demo_doctor
# bcrypt hash of "demo_password" — to regenerate:
#   uv run python -c "import bcrypt; print(bcrypt.hashpw(b'<password>', bcrypt.gensalt()).decode())"
GATEWAY_DOCTOR_PASSWORD_HASH=$2b$12$SIEiIRZTFq4CNcZfsJr9qOWxxYxwjSW3XWs6EWtWm4DAV/sNE7N8i
GATEWAY_SESSION_SECRET=change-me-in-production-32-bytes-minimum
GATEWAY_SESSION_TTL_HOURS=8
ON_PREMISE_API_URL=http://127.0.0.1:8001
CLOUD_API_URL=http://127.0.0.1:8002
GATEWAY_AUDIT_RETENTION_DAYS=730
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_PER_MIN=60
GATEWAY_LOG_LEVEL=info
GATEWAY_OUTPUT_DIR=application/gateway/output
GATEWAY_AUDIT_DIR=application/gateway/audit
ON_PREMISE_AUDIT_DIR=application/on_premise/audit
