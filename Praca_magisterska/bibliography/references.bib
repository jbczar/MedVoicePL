% ---------------------------------------------------------------------------
% Baza bibliograficzna pracy magisterskiej (BibLaTeX, backend=biber)
%
% Każdy wpis musi być zacytowany w tekście: \cite{klucz}, \parencite{klucz},
% \textcite{klucz}. Wpisy nigdzie nie cytowane NIE powinny zostawać w tej
% bazie (biber z opcją `sorting=none` pokazuje je w kolejności cytowania).
%
% Szablony najczęstszych typów — usuń komentarze i wypełnij pola.
% ---------------------------------------------------------------------------

% Przykład: artykuł w czasopiśmie
% @article{radford2023whisper,
%   author  = {Radford, Alec and Kim, Jong Wook and Xu, Tao and others},
%   title   = {Robust Speech Recognition via Large-Scale Weak Supervision},
%   journal = {Proceedings of the 40th International Conference on Machine Learning},
%   year    = {2023},
%   volume  = {202},
%   pages   = {28492--28518}
% }

% Przykład: książka
% @book{knuth1984texbook,
%   author    = {Knuth, Donald E.},
%   title     = {The \TeX book},
%   year      = {1984},
%   publisher = {Addison-Wesley},
%   address   = {Reading, MA}
% }

% Przykład: źródło internetowe
% @online{presidio-docs,
%   author  = {{Microsoft}},
%   title   = {Presidio --- Data Protection and De-identification SDK},
%   year    = {2026},
%   url     = {https://microsoft.github.io/presidio/},
%   urldate = {2026-04-21}
% }

% Przykład: repozytorium / oprogramowanie
% @software{faster-whisper,
%   author       = {Klein, Guillaume},
%   title        = {faster-whisper: Faster Whisper transcription with CTranslate2},
%   year         = {2024},
%   url          = {https://github.com/SYSTRAN/faster-whisper},
%   version      = {1.0.0}
% }

% Przykład: praca dyplomowa
% @thesis{doe2026thesis,
%   author      = {Doe, John},
%   title       = {Tytuł pracy},
%   type        = {Praca magisterska},
%   institution = {Polsko-Japońska Akademia Technik Komputerowych},
%   year        = {2026}
% }
